{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:custom_name",
    "on_true": {
      "type": "minecraft:model",
      "model": "mooncake_overflow:item/mooncake_icon_composite"
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "mooncake_overflow:mooncake_kind",
      "cases": [
        {
          "when": "round_square",
          "model": {
            "type": "minecraft:model",
            "model": "mooncake_overflow:item/mooncake_icon_square"
          }
        },
        {
          "when": "round_flower",
          "model": {
            "type": "minecraft:model",
            "model": "mooncake_overflow:item/mooncake_icon_flower"
          }
        },
        {
          "when": "square_round",
          "model": {
            "type": "minecraft:model",
            "model": "mooncake_overflow:item/mooncake_icon_round"
          }
        },
        {
          "when": "square_square",
          "model": {
            "type": "minecraft:model",
            "model": "mooncake_overflow:item/mooncake_icon_square"
          }
        },
        {
          "when": "square_flower",
          "model": {
            "type": "minecraft:model",
            "model": "mooncake_overflow:item/mooncake_icon_flower"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "mooncake_overflow:item/mooncake_icon_round"
      }
    }
  }
}
